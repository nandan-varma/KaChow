@page
@using ContosoCrafts.WebSite.Components
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}


<!-- Bootstrap carousel -->

<div id="carouselExampleControls" class="carousel slide" data-ride="carousel">
    <!-- Imports for carousel -->
    @using ContosoCrafts.WebSite.Models
    @using ContosoCrafts.WebSite.Services
    @using Microsoft.AspNetCore.Components.Web
    @inject JsonFileProductService ProductService

    <!-- Carousel inner working mechanism -->
    <div class="carousel-inner">
        
        <!-- Retrieve the data from the ProductService  -->
        @{
            var data = ProductService.GetAllData().ToList();
        }

        <!-- Set a default active item as Product 0 -->
        <div class="carousel-item active">
            <img src="@data[0].Image" class="d-block w-100" alt="...">
        </div>

        <!-- Generate inactive items for all other products -->
        @for (int i = 1; i < data.Count(); i++)
        {
            <div class="carousel-item">
                <img src="@data[i].Image" class="d-block w-100" alt="...">
            </div>
        }
    </div>

    <!-- Previous product controller -->
    <a class="carousel-control-prev" href="#carouselExampleControls" role="button" data-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="sr-only">Previous</span>
    </a>
    <!-- Next product controller -->
    <a class="carousel-control-next" href="#carouselExampleControls" role="button" data-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="sr-only">Next</span>
    </a>
</div>

<!-- Surprise me button -->
<div class="container surprise-me-container">
    <!-- Initialize a random, choose an index with the help of the random, get the random product using random index -->
    @{
        Random random = new Random();
        int index = random.Next(1, data.Count);
        var product = data[index];
    }
    <!-- Actual button for the suprise me feature -->
    <a class="btn-primary surprise-me-button" href="/Product/Read/@product.Id">Surprise me!</a>
</div>

@(await Html.RenderComponentAsync<ProductList>(RenderMode.ServerPrerendered))

<script src="_framework/blazor.server.js"></script>
