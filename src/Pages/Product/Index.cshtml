@page
@model ContosoCrafts.WebSite.Pages.Product.IndexModel
@{
    ViewData["Title"] = "Index page";
}

<div class="container">
    <!-- Button to navigate to the Create Product page -->
    <div class="create-product-button-container">
        <a class="create-product-button" href="/Product/Create">Create</a>
    </div>

    <!-- Table to display the list of products with their details -->
    <table class="table table-bordered table-striped">
        <thead class="products-header-container">
            <tr class="products-header-names">
                <th>Name</th>
                <th>Description</th>
                <th>Image</th>
                <th>Actions</th> <!-- Added for action links (Read, Update, Delete) -->
            </tr>
        </thead>
        <tbody>
            <!-- Loop through each product in the Products model and display its details -->
            @foreach (var product in Model.Products)
            {
                <tr class="products-list-container">
                    <!-- Display product name -->
                    <td>@product.Name</td>

                    <!-- Display product description -->
                    <td>@product.Description</td>

                    <!-- Display product image as a background image in a div -->
                    <td>
                        <div class="card-img" style="background-image: url('@product.Image'); background-size: contain;"></div>
                    </td>

                    <!-- Display product actions -->
                    <td>
                        <a href="/Product/Read/@product.Id">Read</a>
                        <a href="/Product/Update/@product.Id">Update</a>
                        <a href="/Product/Delete/@product.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
