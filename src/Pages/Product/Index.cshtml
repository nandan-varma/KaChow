@page
@model ContosoCrafts.WebSite.Pages.Product.IndexModel
@{
    ViewData["Title"] = "Index page";
}



<div class="container">
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Image</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Description</td>
                    <td>
                        <div class="card-img" style="background-image: url('@product.Image'); background-size: contain;"></div>
                    </td>
                    <td><a href="/Product/Read/@product.Id">Read</a></td>
                    <td><a href="/Product/Update/@product.Id">Update</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>