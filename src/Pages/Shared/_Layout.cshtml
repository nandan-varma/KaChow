@using ContosoCrafts.WebSite.Models
@using ContosoCrafts.WebSite.Services
@using Microsoft.AspNetCore.Components.Web
@inject JsonFileProductService ProductService

<!DOCTYPE html>
<html lang="en">
<head>
    <base href="~/" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="keywords" content="Cars Movie Plushies Lightning McQueen Mator" />
    <title>@ViewData["Title"] - Ka-Chow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="icon" href="/Images/logo.svg" type="image/x-icon">
</head>
<body>
    <header class="navbar-header">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-navbar border-bottom box-shadow mb-3">
            <div class="container">
                <img class="logo" src="/Images/logo.svg" alt="Kachow Logo" />
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <span style="font-size: 1.5em; font-weight: bold;">Ka-chow</span><br />
                    <span style="font-size: 0.75em;">A Plush Pit Stop</span>
                </a>
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex flex-sm-row-reverse">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Product">Products</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/About">About Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/FAQ">FAQ</a>
                        </li>
                        <li class="nav-item">
                            <span id="theme-toggle" class="theme-toggle">&#9728;</span> <!-- Theme toggle button -->
                        </li>
                    </ul>
                </div>
            </div>
            <p class="lightning">95</p>
        </nav>
    </header>

    <div class="contaier">
        <main role="main" class="pb-3 pl-lg-5 pr-lg-5">
            @RenderBody()
        </main>
        <button class="contact-us-button" onclick="window.open('https://docs.google.com/forms/d/e/1FAIpQLSdf3K1yFYra8FipsWytKkp202RyrNWzCLvucg0DU0k-Ek-zEg/viewform?usp=sf_link', '_blank')">
            Contact Us
        </button>
    </div>

    <footer  class="border-top footer text-muted bg-footer">
        <div class="footer-title-name">
            &copy; 2024 - Kachow  
        </div>
        <div class="footer-container">
            <a asp-area="" asp-page="/Privacy">Privacy</a>
            <a asp-area="" asp-page="/About">About Us</a>
            <a asp-area="" asp-page="/FAQ">FAQ</a>
        </div>
    </footer>

    <button id="back-to-top" title="Back to top">&#8679;</button>

    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
