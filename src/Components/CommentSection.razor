@using ContosoCrafts.WebSite.Models
@using ContosoCrafts.WebSite.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web

@inject JsonFileProductService ProductService

<EditForm Model="model" OnValidSubmit="@(() => SubmitComment())"> 
    @* Form for submitting comments *@
    <DataAnnotationsValidator />
    <ValidationSummary /> 

    <div class="form-group">
        @* Input field for adding a comment *@
        <label for="Comment">Comment: </label>
        <textarea id="comment-box" class="form-control" @bind=model.Comment></textarea>
        @* Displays validation message for the Comment field *@
        <ValidationMessage For="@(() => model.Comment)"></ValidationMessage>

        @* Button to submit the comment *@
        <button id="submit-button" class="btn btn-primary">
            Submit Comment
        </button>
    </div>
</EditForm>

<div>
    @* Displays a list of comments *@
    <ul class="list-group">
        @foreach (string comment in comments)
        {
            <li class="list-group-item text-wrap text-break">@comment</li>
        }
    </ul>

    @* Buttons to navigate between pages of comments *@
    <button id="Decrement-button" class="btn btn-primary" onclick="@(() => DecrementPageNumber())">Last Page</button>
    <button id="Increment-button" class="btn btn-primary" onclick="@(() => IncrementPageNumber())">Next Page</button>
</div>

@code {
    [Parameter]
    public string Id { get; set; } // Parameter for product ID (from parent or route)
    public string productId { get; set; } // Internal representation of product ID
    public CommentModel model = new CommentModel(); // Model for binding comment data
    public int PageNumber = 0; // Current page number for pagination
    public List<string> comments; // List to store and display comments

    /// <summary>
    /// Method to submit a new comment
    /// </summary>
    public void SubmitComment()
    {
        // Add the comment to the Selected Product
        ProductService.AddComment(productId, model);
        comments = ProductService.GetPageOfComments(productId, PageNumber);
        if (comments == null)
        {
            comments = new List<string>();
        }
    }

    /// <summary>
    /// Increments the page number after a check
    /// </summary>
    public void IncrementPageNumber()
    {
        List<string> NextPage = ProductService.GetPageOfComments(productId, PageNumber + 1);
        if (NextPage != null)
        {
            PageNumber += 1;
            comments = NextPage;
        }
    }

    /// <summary>
    /// Decrements the page number after a check
    /// </summary>
    public void DecrementPageNumber()
    {
        if (PageNumber > 0)
        {
            PageNumber -= 1;
        }
        comments = ProductService.GetPageOfComments(productId, PageNumber);
    }
    /// <summary>
    /// Method to fetch comments for the selected product
    /// </summary>
    protected override void OnParametersSet()
    {
        productId = Id;
        comments = ProductService.GetPageOfComments(productId, PageNumber);
        if (comments == null)
        {
            comments = new List<string>();
        }
    }

    /// <summary>
    /// Method to initialize the comment section
    /// </summary>
    protected override void OnInitialized()
    {
        Console.WriteLine("Initialized Read Comment Section");
    }
}
