@using ContosoCrafts.WebSite.Models
@using ContosoCrafts.WebSite.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@inject JsonFileProductService ProductService
@* Service for product data *@
@inject RatingService RatingService
@* Service for managing ratings *@

<div class="search-filter">
    <input type="text" @bind="SearchTerm" placeholder="Search products..." class="form-control search-input" />
    <select @bind="MinRating" class="form-control rating-filter">
        <option value="0">All Ratings</option>
        <option value="1">1 ★ & Up</option>
        <option value="2">2 ★ & Up</option>
        <option value="3">3 ★ & Up</option>
        <option value="4">4 ★ & Up</option>
        <option value="5">5 ★ </option>
    </select>
    <button @onclick="ApplyFilters" class="btn btn-primary apply-button">Apply</button>
</div>

<div class="card-columns">
    @foreach (var product in FilteredProducts) // Loop through each filtered product
    {
        <div class="card">
            <!-- Link to product detail page -->
            <div onclick="window.location.href='/Product/Read/@product.Id'" class="card-img" style="background-image: url('@product.Image'); cursor: pointer;">
            </div>
            <div class="card-body">
                <h5 class="card-title">@product.Name</h5>
                <p>@product.Model</p>
            </div>
            <div class="card-footer">
                <small class="text-muted">
                    <!-- Button to show more product info -->
                    <button @onclick="(e => SelectProduct(product.Id))"
                            data-toggle="modal" data-target="#productModal" class="btn btn-primary">
                        More Info
                    </button>
                </small>
            </div>
        </div>
    }
</div>

@if (SelectedProduct != null) // Check if a product is selected
{
    <div class="modal fade" id="productModal" tabindex="-1" role="dialog" aria-labelledby="productTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="productTitle">@SelectedProduct.Name</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="card">
                        <div class="card-img" style="background-image: url('@SelectedProduct.Image');">
                        </div>
                        <div class="card-body">
                            <p class="card-text">@SelectedProduct.Description</p>
                        </div>
                    </div>
                </div>
                <div class="modal-body">
                    @* Display message if no votes *@
                    @if (VoteCount == 0)
                    {
                        <span>Be the first to vote!</span>
                    }

                    @* Display vote count only if there are votes *@
                    @if (VoteCount > 0)
                    {
                        <span>@VoteCount @VoteLabel</span>
                    }

                    @* Display star rating system *@
                    @for (int i = 1; i < 6; i++)
                    {
                        var currentStar = i;
                        // Display checked or unchecked star based on current rating
                        <span class="fa fa-star @(i <= CurrentRating ? "checked" : "")" @onclick="() => SubmitRating(SelectedProduct.Id, currentStar)"></span>
                    }
                <EditForm Model="model" OnValidSubmit="SubmitComment">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                        <div class ="form-group">
                        <label for="Comment">Comment: </label>
                            <textarea class="form-control" @bind=model.Comment></textarea>
                        <ValidationMessage For="@(() => model.Comment)"></ValidationMessage>

                            <button class="btn btn-primary" onclick="submit">
                            Submit Comment
                        </button>
                    </div>
                </EditForm>
                    <div>
                        <ul class="list-group">
                            @foreach (string comment in comments)
                            {
                                <li class="list-group-item text-wrap text-break">@comment</li>
                            }
                        </ul>
                        <button class="btn btn-primary" onclick="@(() => DecrementPageNumber())">Last Page</button>
                        <button class="btn btn-primary" onclick="@(() => IncrementPageNumber())">Next Page</button>
            </div>
        </div>
    </div>
        </div>
    </div>
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"> <!-- Font Awesome for star icons -->
@code
{
    public ProductModel SelectedProduct { get; set; } // Currently selected product
    public string SelectedProductId { get; set; } // ID of the selected product
    public CommentModel model = new CommentModel();

    /// <summary>
    /// Method to select a product and fetch its current rating
    /// </summary>
    /// <param name="productId"></param>
    public void SelectProduct(string productId)
    {
        SelectedProductId = productId;
        SelectedProduct = ProductService.GetAllData().First(x => x.Id == productId);
        GetCurrentRating();
    }

    public int CurrentRating = 0; // Holds the current rating value
    public int VoteCount = 0; // Counts the number of votes
    public string VoteLabel; // Label for votes

    /// <summary>
    /// Method to calculate current rating based on received ratings
    /// </summary>
    /// <returns></returns>
    public int GetCurrentRating()
    {
        if (SelectedProduct.Ratings == null) // Check for no ratings
        {
            CurrentRating = 0;
            VoteCount = 0;

            // Return current rating early if no ratings
            return CurrentRating;
        }

        // Proceed with rating calculation if ratings are present
        VoteCount = SelectedProduct.Ratings.Count();

        // Set appropriate label
        VoteLabel = VoteCount > 1 ? "Votes" : "Vote";

        // Calculate average rating
        CurrentRating = SelectedProduct.Ratings.Sum() / VoteCount;

        // Return current rating
        return CurrentRating;
    }

    /// <summary>
    /// Method to submit a new rating
    /// </summary>
    /// <param name="productId"></param>
    /// <param name="rating"></param>
    public void SubmitRating(string productId, int rating)
    {
        // Add new rating to the product
        ProductService.AddRating(productId, rating);

        // Update the selected product
        SelectProduct(productId);
    }

    /// <summary>
    /// Method to submit a new comment
    /// </summary>
    public void SubmitComment()
    {
        // Add the comment to the Selected Product
        ProductService.AddComment(SelectedProductId, model);
    }

    public string SearchTerm { get; set; } = string.Empty; // Holds the search term
    public int MinRating { get; set; } = 0; // Holds the minimum rating filter
    public IEnumerable<ProductModel> FilteredProducts { get; set; } // Holds the filtered products

    /// <summary>
    /// Method to apply search and rating filters
    /// </summary>
    public void ApplyFilters()
    {
        var products = ProductService.GetAllData();
        products = ProductService.SearchProducts(SearchTerm);
        products = ProductService.FilterProductsByRating(products, MinRating);
        FilteredProducts = products;
    }

    /// <summary>
    /// Method called when the component is initialized
    /// </summary>
    protected override void OnInitialized()
    {
        FilteredProducts = ProductService.GetAllData(); // Initialize with all products
    }
}