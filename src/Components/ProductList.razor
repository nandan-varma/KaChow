@using ContosoCrafts.WebSite.Models
@using ContosoCrafts.WebSite.Services
@using Microsoft.AspNetCore.Components.Web
@inject JsonFileProductService ProductService // Service for product data
@inject RatingService RatingService // Service for managing ratings

<div class="card-columns">
    @foreach (var product in ProductService.GetAllData()) // Loop through each product
    {
        <div class="card">
            <!-- Link to product detail page -->
            <div onclick="window.location.href='/Product/Read/@product.Id'" class="card-img" style="background-image: url('@product.Image'); cursor: pointer;">
            </div>
            <div class="card-body">
                <h5 class="card-title">@product.Name</h5>
                <p>@product.Model</p>
            </div>
            <div class="card-footer">
                <small class="text-muted">
                    <!-- Button to show more product info -->
                    <button @onclick="(e => SelectProduct(product.Id))"
                            data-toggle="modal" data-target="#productModal" class="btn btn-primary">
                        More Info
                    </button>
                </small>
            </div>
        </div>
    }
</div>

@if (SelectedProduct != null) // Check if a product is selected
{
    <div class="modal fade" id="productModal" tabindex="-1" role="dialog" aria-labelledby="productTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="productTitle">@SelectedProduct.Name</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="card">
                        <div class="card-img" style="background-image: url('@SelectedProduct.Image');">
                        </div>
                        <div class="card-body">
                            <p class="card-text">@SelectedProduct.Description</p>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    @if (VoteCount == 0) // Display message if no votes
                    {
                        <span>Be the first to vote!</span>
                    }

                    @if (VoteCount > 0) // Display vote count only if there are votes
                    {
                        <span>@VoteCount @VoteLabel</span>
                    }

                    // Display star rating system
                    @for (int i = 1; i < 6; i++)
                    {
                        var currentStar = i;
                        // Display checked or unchecked star based on current rating
                        <span class="fa fa-star @(i <= CurrentRating ? "checked" : "")" onclick="SubmitRating('@SelectedProduct.Id', @currentStar)"></span>
                    }
                </div>
            </div>
        </div>
    </div>
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"> <!-- Font Awesome for star icons -->
@code
{
    public ProductModel SelectedProduct { get; set; } // Currently selected product
    public string SelectedProductId { get; set; } // ID of the selected product

    // Method to select a product and fetch its current rating
    public void SelectProduct(string productId)
    {
        SelectedProductId = productId;
        SelectedProduct = ProductService.GetAllData().First(x => x.Id == productId);
        GetCurrentRating();
    }

    public int CurrentRating = 0; // Holds the current rating value
    public int VoteCount = 0; // Counts the number of votes
    public string VoteLabel; // Label for votes

    // Method to calculate current rating based on received ratings
    public int GetCurrentRating()
    {
        if (SelectedProduct.Ratings == null) // Check for no ratings
        {
            CurrentRating = 0;
            VoteCount = 0;
            System.Console.WriteLine($"Current rating for {SelectedProduct.Id}: {CurrentRating}");
            return CurrentRating; // Return current rating early if no ratings
        }

        // Proceed with rating calculation if ratings are present
        VoteCount = SelectedProduct.Ratings.Count();
        VoteLabel = VoteCount > 1 ? "Votes" : "Vote"; // Set appropriate label
        CurrentRating = SelectedProduct.Ratings.Sum() / VoteCount; // Calculate average rating

        System.Console.WriteLine($"Current rating for {SelectedProduct.Id}: {CurrentRating}");
        return CurrentRating; // Return current rating
    }


    // Method to submit a new rating
    public void SubmitRating(string productId, int rating)
    {
        ProductService.AddRating(productId, rating); // Add the rating
        GetCurrentRating(); // Update current rating
    }
}
